# scalability_100m — generated by make_scal_dim.py
load "../../common/plot/common.gp"
LEGROWS = 1
FONT = "Carlito"; FT = 6.5; FL = 7.0
PW = 66.550; PH = 55.0; PBOT = 17.5; LEGB = LEGROWS*8.5 + (LEGROWS ? 1.0 : 0.0)
W = 241.15; H = PBOT + PH + 0.8 + LEGB; OUT = "scalability_100m"
eval SETTERM
set style line 1 lc rgb C_PINK   lw LW pt 4  ps PS             # BBQ
set style line 2 lc rgb C_PURPLE lw LW pt 12 ps PS*1.25        # TurboQuant 1bit
set style line 3 lc rgb C_BLUE   lw LW pt 6  ps PS             # RaBitQ 1bit + adaptive rerank
set style line 4 lc rgb C_BLUE   lw LW pt 8  ps PS*1.1 dt (6,3) # RaBitQ 7bit (RAM)
set multiplot
SMP = 9.0; GST = 2.0
LY = H - 4.75; LX = (W - 226.69)/2.0
set arrow 101 from screen sx(LX),sy(LY) to screen sx(LX+SMP),sy(LY) nohead ls 1 front
set label 111 "" at screen sx(LX+SMP/2),sy(LY) point ls 1 lw MLW front
set label 121 "BBQ" at screen sx(LX+SMP+GST),sy(LY) left font ",6.0" front
LX = LX + SMP + GST + 10.56 + 5.0
set arrow 102 from screen sx(LX),sy(LY) to screen sx(LX+SMP),sy(LY) nohead ls 2 front
set label 112 "" at screen sx(LX+SMP/2),sy(LY) point ls 2 lw MLW front
set label 122 "TurboQuant 1bit" at screen sx(LX+SMP+GST),sy(LY) left font ",6.0" front
LX = LX + SMP + GST + 40.64 + 5.0
set arrow 103 from screen sx(LX),sy(LY) to screen sx(LX+SMP),sy(LY) nohead ls 3 front
set label 113 "" at screen sx(LX+SMP/2),sy(LY) point ls 3 lw MLW front
set label 123 "RaBitQ 1bit + adaptive rerank" at screen sx(LX+SMP+GST),sy(LY) left font ",6.0" front
LX = LX + SMP + GST + 71.87 + 5.0
set arrow 104 from screen sx(LX),sy(LY) to screen sx(LX+SMP),sy(LY) nohead ls 4 front
set label 114 "" at screen sx(LX+SMP/2),sy(LY) point ls 4 lw MLW front
set label 124 "RaBitQ 7bit (RAM)" at screen sx(LX+SMP+GST),sy(LY) left font ",6.0" front
LX = LX + SMP + GST + 44.61 + 5.0
eval DRAWSCREEN
set tics in nomirror scale TICMAJ,0 font ",".sprintf("%g",FT)
unset mxtics; unset mytics
set logscale y
set yrange [45.0:9569.3]
set nonlinear x via -log10(1-x) inverse 1-10**(-x)
D = "scalability_100m.dat"
# 10M
set origin (19.5 + 0*(PW + 8.0))/W, PBOT/H; set size PW/W, PH/H
set lmargin 0; set rmargin 0; set tmargin 0; set bmargin 0
set lmargin at screen (19.5 + 0*(PW + 8.0))/W; set rmargin at screen (19.5 + 0*(PW + 8.0)+PW)/W; set bmargin at screen PBOT/H; set tmargin at screen (PBOT+PH)/H
unset nonlinear x
set xrange [0.94725:0.99417]
set nonlinear x via -log10(1-x) inverse 1-10**(-x)
set xtics ("0.95" 0.95, "0.98" 0.98, "0.99" 0.99) offset 0,0.45
set ytics ("50" 50, "100" 100, "200" 200, "500" 500, "1k" 1000, "2k" 2000, "5k" 5000) offset 0.3,0
set ylabel "QPS" font ",7" offset 1.0,0
set xlabel "Recall\\@10" font ",7" offset 0,1.0
unset title
plot for [m in "bbq tq rbq1 rbq7"] D index m."_0_curve" u 1:2 w l ls (m eq "bbq" ? 1 : m eq "tq" ? 2 : m eq "rbq1" ? 3 : 4) notitle, for [m in "bbq tq rbq1 rbq7"] D index m."_0_pts" u 1:2 w p ls (m eq "bbq" ? 1 : m eq "tq" ? 2 : m eq "rbq1" ? 3 : 4) lw MLW notitle
# 50M
set origin (19.5 + 1*(PW + 8.0))/W, PBOT/H; set size PW/W, PH/H
set lmargin 0; set rmargin 0; set tmargin 0; set bmargin 0
set lmargin at screen (19.5 + 1*(PW + 8.0))/W; set rmargin at screen (19.5 + 1*(PW + 8.0)+PW)/W; set bmargin at screen PBOT/H; set tmargin at screen (PBOT+PH)/H
unset nonlinear x
set xrange [0.94282:0.99539]
set nonlinear x via -log10(1-x) inverse 1-10**(-x)
set xtics ("0.95" 0.95, "0.98" 0.98, "0.99" 0.99, "0.995" 0.995) offset 0,0.45
set ytics ("" 50, "" 100, "" 200, "" 500, "" 1000, "" 2000, "" 5000) offset 0.3,0
unset ylabel
set xlabel "Recall\\@10" font ",7" offset 0,1.0
unset title
plot for [m in "bbq tq rbq1 rbq7"] D index m."_1_curve" u 1:2 w l ls (m eq "bbq" ? 1 : m eq "tq" ? 2 : m eq "rbq1" ? 3 : 4) notitle, for [m in "bbq tq rbq1 rbq7"] D index m."_1_pts" u 1:2 w p ls (m eq "bbq" ? 1 : m eq "tq" ? 2 : m eq "rbq1" ? 3 : 4) lw MLW notitle
# 100M
set origin (19.5 + 2*(PW + 8.0))/W, PBOT/H; set size PW/W, PH/H
set lmargin 0; set rmargin 0; set tmargin 0; set bmargin 0
set lmargin at screen (19.5 + 2*(PW + 8.0))/W; set rmargin at screen (19.5 + 2*(PW + 8.0)+PW)/W; set bmargin at screen PBOT/H; set tmargin at screen (PBOT+PH)/H
unset nonlinear x
set xrange [0.93247:0.99536]
set nonlinear x via -log10(1-x) inverse 1-10**(-x)
set xtics ("0.95" 0.95, "0.98" 0.98, "0.99" 0.99, "0.995" 0.995) offset 0,0.45
set ytics ("" 50, "" 100, "" 200, "" 500, "" 1000, "" 2000, "" 5000) offset 0.3,0
unset ylabel
set xlabel "Recall\\@10" font ",7" offset 0,1.0
unset title
plot for [m in "bbq tq rbq1 rbq7"] D index m."_2_curve" u 1:2 w l ls (m eq "bbq" ? 1 : m eq "tq" ? 2 : m eq "rbq1" ? 3 : 4) notitle, for [m in "bbq tq rbq1 rbq7"] D index m."_2_pts" u 1:2 w p ls (m eq "bbq" ? 1 : m eq "tq" ? 2 : m eq "rbq1" ? 3 : 4) lw MLW notitle
unset multiplot
