+inline const XFlagDimAlpha& xflag_dim_alpha() {
+    static const XFlagDimAlpha config = [] {
+        XFlagDimAlpha out;
+        const char* path = std::getenv("FAISS_XFLAG_ALPHA_FILE");
+        if (path == nullptr || path[0] == '\0') {
