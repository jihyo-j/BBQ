+    FAISS_THROW_IF_NOT(scales);
+    const IndexBinaryFlat* flat_storage = dynamic_cast<const IndexBinaryFlat*>(storage);
+    FAISS_THROW_IF_NOT_MSG(
+            flat_storage != nullptr && flat_storage->has_block_scales(),
+            "IndexBinaryHNSW block-scale search requires IndexBinaryFlat block scales");
+    if (params_in) {
