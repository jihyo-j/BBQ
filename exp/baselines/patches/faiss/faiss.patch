+    static FAISS_ALWAYS_INLINE void encode_component(
+            float x,
+            uint8_t* code,
+            size_t i) {
+        int bits = (int)(x * 3.0f);
+        const size_t byte_idx = i >> 2;
+        const size_t shift = (i & 3) << 1;
+        code[byte_idx] |= (bits & 0x3) << shift;
