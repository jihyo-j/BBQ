+static bool packed_bit_is_set(const uint8_t* bits, size_t bit_no) {
+    return (bits[bit_no / 8] & (uint8_t(1) << (7 - (bit_no % 8)))) != 0;
+}
+
+struct HNSWSQXFlagDistanceComputer : DistanceComputer {
+    const IndexHNSWSQ& index;
+    const IndexScalarQuantizer& sq_storage;
+    std::unique_ptr<FlatCodesDistanceComputer> base;
+    std::vector<float> decoded;
+    const float* query = nullptr;
+    const uint8_t* query_xflags = nullptr;
+
+    HNSWSQXFlagDistanceComputer(
+            const IndexHNSWSQ& index,
+            const IndexScalarQuantizer& sq_storage)
+            : index(index),
+              sq_storage(sq_storage),
+              base(sq_storage.get_FlatCodesDistanceComputer()),
+              decoded(index.d) {}
+
+    void set_query(const float* x) override {
+        query = x;
+        base->set_query(x);
+    }
+
+    void set_query_with_xflags(const float* x, const uint8_t* xflags) {
+        query_xflags = xflags;
+        set_query(x);
+    }
+
+    float operator()(idx_t i) override {
+        float score = (*base)(i);
+        const uint8_t* db_xflags =
+                index.xflags.data() + size_t(i) * index.xflag_code_size;
+        const uint8_t* code = sq_storage.codes.data() +
+                size_t(i) * sq_storage.code_size;
+        sq_storage.sa_decode(1, code, decoded.data());
+
+        float weak_tail_score = 0.0f;
+        const size_t tail_dim = size_t(index.d - index.xflag_split);
+        for (size_t t = 0; t < tail_dim; ++t) {
+            if (packed_bit_is_set(query_xflags, t) &&
+                packed_bit_is_set(db_xflags, t)) {
+                const size_t dim = size_t(index.xflag_split) + t;
+                weak_tail_score += query[dim] * decoded[dim];
+            }
+        }
+        return -(score - weak_tail_score);
+    }
+
+    void distances_batch_4(
+            const idx_t idx0,
+            const idx_t idx1,
+            const idx_t idx2,
+            const idx_t idx3,
+            float& dis0,
+            float& dis1,
+            float& dis2,
+            float& dis3) override {
+        dis0 = (*this)(idx0);
+        dis1 = (*this)(idx1);
+        dis2 = (*this)(idx2);
+        dis3 = (*this)(idx3);
+    }
+
+    float symmetric_dis(idx_t i, idx_t j) override {
+        return -base->symmetric_dis(i, j);
+    }
+};
+
+template <class BlockResultHandler>
+void hnsw_search_sq_xflags(
+        const IndexHNSWSQ* index,
+        idx_t n,
+        const float* x,
+        const uint8_t* qxflags,
+        BlockResultHandler& bres,
+        const SearchParameters* params) {
+    FAISS_THROW_IF_NOT_MSG(index->storage, "IndexHNSWSQ has no storage");
+    FAISS_THROW_IF_NOT_MSG(
+            index->metric_type == METRIC_INNER_PRODUCT,
+            "xflag-aware SQ HNSW search currently supports inner product only");
+    FAISS_THROW_IF_NOT_MSG(
+            index->xflag_code_size > 0 && index->xflags.size() ==
+                            size_t(index->ntotal) * index->xflag_code_size,
+            "IndexHNSWSQ xflags are not initialized; call add_with_xflags first");
+
+    const auto* sq_storage = dynamic_cast<const IndexScalarQuantizer*>(index->storage);
+    FAISS_THROW_IF_NOT_MSG(
+            sq_storage, "xflag-aware SQ HNSW search requires IndexScalarQuantizer storage");
+
+    const HNSW& hnsw = index->hnsw;
+    int efSearch = hnsw.efSearch;
+    if (params) {
+        if (const SearchParametersHNSW* hnsw_params =
+                    dynamic_cast<const SearchParametersHNSW*>(params)) {
+            efSearch = hnsw_params->efSearch;
+        }
+    }
+    size_t n1 = 0, n2 = 0, ndis = 0, nhops = 0;
+
+    idx_t check_period = InterruptCallback::get_period_hint(
+            hnsw.max_level * index->d * efSearch);
