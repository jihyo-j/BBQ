+// Fast path for the final OR-half rule. Scores are scaled by two:
+// strong sign mismatches cost 2 and any coordinate marked weak by either
+// vector costs 1, independent of the sign bits.
+inline int xflag_or_half_hamming(
+        const uint8_t* a,
+        const uint8_t* ax,
+        const uint8_t* b,
+        const uint8_t* bx,
+        int code_size) {
+    int offset = 0;
+    int score = 0;
+
+#if defined(__AVX512F__)
+    __m512i score64 = _mm512_setzero_si512();
+    for (; offset + 64 <= code_size; offset += 64) {
+        const __m512i av = _mm512_loadu_si512(a + offset);
+        const __m512i axv = _mm512_loadu_si512(ax + offset);
+        const __m512i bv = _mm512_loadu_si512(b + offset);
+        const __m512i bxv = _mm512_loadu_si512(bx + offset);
+        const __m512i neutral = _mm512_or_si512(axv, bxv);
+        const __m512i strong_mismatch = _mm512_andnot_si512(
+                neutral, _mm512_xor_si512(av, bv));
+        score64 = _mm512_add_epi64(
+                score64,
+                _mm512_add_epi64(
+                        _mm512_slli_epi64(
+                                xflag_popcount_512(strong_mismatch), 1),
+                        xflag_popcount_512(neutral)));
+    }
+    score += xflag_reduce_512(score64);
+#elif defined(__AVX2__)
+    __m256i score32 = _mm256_setzero_si256();
+    for (; offset + 32 <= code_size; offset += 32) {
+        const __m256i av =
+                _mm256_loadu_si256((const __m256i_u*)(a + offset));
+        const __m256i axv =
+                _mm256_loadu_si256((const __m256i_u*)(ax + offset));
+        const __m256i bv =
+                _mm256_loadu_si256((const __m256i_u*)(b + offset));
+        const __m256i bxv =
+                _mm256_loadu_si256((const __m256i_u*)(bx + offset));
+        const __m256i neutral = _mm256_or_si256(axv, bxv);
+        const __m256i strong_mismatch = _mm256_andnot_si256(
+                neutral, _mm256_xor_si256(av, bv));
+        score32 = _mm256_add_epi64(
+                score32,
+                _mm256_add_epi64(
+                        _mm256_slli_epi64(
+                                xflag_popcount_256(strong_mismatch), 1),
+                        xflag_popcount_256(neutral)));
+    }
+    score += xflag_reduce_256(score32);
+#endif
+
+    for (; offset + 8 <= code_size; offset += 8) {
+        uint64_t av;
+        uint64_t axv;
+        uint64_t bv;
+        uint64_t bxv;
+        std::memcpy(&av, a + offset, sizeof(av));
+        std::memcpy(&axv, ax + offset, sizeof(axv));
+        std::memcpy(&bv, b + offset, sizeof(bv));
+        std::memcpy(&bxv, bx + offset, sizeof(bxv));
+        const uint64_t neutral = axv | bxv;
+        score += 2 * popcount64((av ^ bv) & ~neutral) +
+                popcount64(neutral);
+    }
+    for (; offset < code_size; ++offset) {
+        const uint8_t neutral = ax[offset] | bx[offset];
+        const uint8_t strong_mismatch =
+                uint8_t((a[offset] ^ b[offset]) & uint8_t(~neutral));
+        score += 2 * popcount32(strong_mismatch) + popcount32(neutral);
+    }
+    return score;
+}
+
+inline int xflag_hamming(
+        const uint8_t* a,
+        const uint8_t* ax,
+        const uint8_t* b,
+        const uint8_t* bx,
+        int code_size,
+        const XFlagConfig& config) {
+    int accu = 0;
+    int weak_mismatch = 0;
+    int weak_neutral = 0;
+    const int n64 = code_size / 8;
+    const uint64_t* a64 = reinterpret_cast<const uint64_t*>(a);
+    const uint64_t* ax64 = reinterpret_cast<const uint64_t*>(ax);
+    const uint64_t* b64 = reinterpret_cast<const uint64_t*>(b);
+    const uint64_t* bx64 = reinterpret_cast<const uint64_t*>(bx);
+    for (int i = 0; i < n64; ++i) {
+        const uint64_t mismatch = a64[i] ^ b64[i];
+        const uint64_t neutral = config.use_or ? (ax64[i] | bx64[i])
+                                               : (ax64[i] & bx64[i]);
+        accu += popcount64(mismatch);
+        weak_mismatch += popcount64(mismatch & neutral);
+        weak_neutral += popcount64(neutral);
+    }
+    for (int i = n64 * 8; i < code_size; ++i) {
+        const uint8_t mismatch = a[i] ^ b[i];
+        const uint8_t neutral =
+                config.use_or ? (ax[i] | bx[i]) : (ax[i] & bx[i]);
+        accu += popcount32(mismatch);
+        weak_mismatch += popcount32(mismatch & neutral);
+        weak_neutral += popcount32(neutral);
+    }
+    const int kept_mismatch = accu - weak_mismatch;
+    const XFlagDimAlpha& dim_alpha = *config.dim_alpha;
+    if (config.use_product_score) {
+        const int den =
+                dim_alpha.enabled ? dim_alpha.den : config.weak_weight_den;
+        const int max_bits = dim_alpha.enabled
+                ? std::min<int>(int(dim_alpha.weights.size()), code_size * 8)
+                : code_size * 8;
+        int product_score = 0;
+        for (int i = 0; i < code_size; ++i) {
+            const uint8_t mismatch = a[i] ^ b[i];
+            if (mismatch == 0) {
+                continue;
+            }
+            const uint8_t strong_both = uint8_t(~(ax[i] | bx[i]));
+            for (int bit = 0; bit < 8; ++bit) {
+                const int dim = i * 8 + bit;
+                if (dim >= max_bits) {
+                    break;
+                }
+                const uint8_t mask = uint8_t(0x80) >> bit;
+                if ((mismatch & mask) == 0) {
+                    continue;
+                }
+                if (strong_both & mask) {
+                    product_score += den;
+                } else if (dim_alpha.enabled) {
+                    product_score += dim_alpha.weights[dim];
+                } else {
+                    product_score += config.weak_weight_num;
+                }
+            }
+        }
+        return product_score;
+    }
+    if (dim_alpha.enabled) {
+        int dim_penalty = 0;
+        const int max_bits =
+                std::min<int>(int(dim_alpha.weights.size()), code_size * 8);
+        for (int i = 0; i < code_size; ++i) {
+            const uint8_t neutral =
+                    config.use_or ? (ax[i] | bx[i]) : (ax[i] & bx[i]);
+            if (neutral == 0) {
+                continue;
+            }
+            for (int bit = 0; bit < 8; ++bit) {
+                const int dim = i * 8 + bit;
+                if (dim >= max_bits) {
+                    break;
+                }
+                if (neutral & (uint8_t(0x80) >> bit)) {
+                    dim_penalty += dim_alpha.weights[dim];
+                }
+            }
+        }
+        return dim_alpha.den * kept_mismatch + dim_penalty;
+    }
+    return config.weak_weight_den * kept_mismatch +
+            config.weak_weight_num * weak_neutral;
+}
+
+
+inline bool block_scale_bit_is_set(const uint8_t* code, int bit) {
+    return (code[bit / 8] & (uint8_t(0x80) >> (bit % 8))) != 0;
+}
