+inline int xflag_reduce_512(__m512i value) {
+    alignas(64) uint64_t lanes[8];
+    _mm512_store_si512(lanes, value);
+    uint64_t total = 0;
+    for (int i = 0; i < 8; ++i) {
+        total += lanes[i];
