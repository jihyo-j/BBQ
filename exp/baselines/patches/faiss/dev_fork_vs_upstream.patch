+void IndexBinaryHNSW::search_with_xflags(
+        idx_t n,
+        const uint8_t* x,
+        const uint8_t* xflags,
+        idx_t k,
+        int32_t* distances,
+        idx_t* labels,
+        const SearchParameters* params_in) const {
+    FAISS_THROW_IF_NOT(k > 0);
+    FAISS_THROW_IF_NOT(xflags);
+    if (params_in) {
+        const SearchParametersHNSW* params =
+                dynamic_cast<const SearchParametersHNSW*>(params_in);
+        FAISS_THROW_IF_NOT_MSG(
+                params, "IndexBinaryHNSW params have incorrect type");
+    }
+
+    float* distances_f = (float*)distances;
+
+    using RH = HeapBlockResultHandler<HNSW::C>;
+    RH bres(n, distances_f, labels, k);
+
+    size_t n1 = 0, n2 = 0, ndis = 0, nhops = 0;
+
+#pragma omp parallel
+    {
+        VisitedTable vt(ntotal);
+        std::unique_ptr<DistanceComputer> dis(get_xflag_distance_computer());
+        std::vector<uint8_t> query_buf(2 * code_size);
+        RH::SingleResultHandler res(bres);
+
+#pragma omp for reduction(+ : n1, n2, ndis, nhops)
+        for (idx_t i = 0; i < n; i++) {
+            res.begin(i);
+            memcpy(query_buf.data(), x + i * code_size, code_size);
+            memcpy(query_buf.data() + code_size,
+                   xflags + i * code_size,
+                   code_size);
+            dis->set_query((float*)query_buf.data());
+            HNSWStats stats = hnsw.search(*dis, nullptr, res, vt, params_in);
+            n1 += stats.n1;
+            n2 += stats.n2;
+            ndis += stats.ndis;
+            nhops += stats.nhops;
+            res.end();
+        }
+    }
+
+    hnsw_stats.combine({n1, n2, ndis, nhops});
+
+#pragma omp parallel for
+    for (idx_t i = 0; i < n * k; ++i) {
+        distances[i] = std::round(distances_f[i]);
+    }
+}
