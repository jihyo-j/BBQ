+            0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4);
+    const __m512i lookup = _mm512_broadcast_i32x4(lookup128);
+    const __m512i low_mask = _mm512_set1_epi8(0x0f);
+    const __m512i lo = _mm512_and_si512(value, low_mask);
+    const __m512i hi =
+            _mm512_and_si512(_mm512_srli_epi16(value, 4), low_mask);
+    const __m512i counts = _mm512_add_epi8(
