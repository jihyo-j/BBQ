+#if defined(__AVX2__)
+inline __m256i xflag_popcount_256(__m256i value) {
+    const __m256i lookup = _mm256_setr_epi8(
+            0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4,
+            0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4);
+    const __m256i low_mask = _mm256_set1_epi8(0x0f);
+    const __m256i lo = _mm256_and_si256(value, low_mask);
+    const __m256i hi =
+            _mm256_and_si256(_mm256_srli_epi16(value, 4), low_mask);
+    const __m256i counts = _mm256_add_epi8(
+            _mm256_shuffle_epi8(lookup, lo),
+            _mm256_shuffle_epi8(lookup, hi));
+    return _mm256_sad_epu8(_mm256_setzero_si256(), counts);
+}
+
+inline int xflag_reduce_256(__m256i value) {
+    const __m128i lo = _mm256_castsi256_si128(value);
+    const __m128i hi = _mm256_extracti128_si256(value, 1);
+    const __m128i sum128 = _mm_add_epi64(lo, hi);
+    return int(
+            uint64_t(_mm_cvtsi128_si64(sum128)) +
+            uint64_t(_mm_extract_epi64(sum128, 1)));
+}
+#endif
