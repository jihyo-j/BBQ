+struct Codec2bit {};
+
+template <>
+struct Codec2bit<SIMDLevel::NONE> {
+    static FAISS_ALWAYS_INLINE void encode_component(
+            float x,
+            uint8_t* code,
+            size_t i) {
+        int bits = (int)(x * 3.0f);
+        const size_t byte_idx = i >> 2;
+        const size_t shift = (i & 3) << 1;
+        code[byte_idx] |= (bits & 0x3) << shift;
+    }
+
+    static FAISS_ALWAYS_INLINE float decode_component(
+            const uint8_t* code,
+            size_t i) {
+        const size_t byte_idx = i >> 2;
+        const size_t shift = (i & 3) << 1;
+        uint8_t bits = (code[byte_idx] >> shift) & 0x3;
+        return (bits + 0.5f) / 3.0f;
+    }
+};
