+        float alpha = 0.0f;
+        while (input >> alpha) {
+            const int weight = std::max(0, int(alpha * out.den + 0.5f));
+            out.weights.push_back(weight);
+        }
+        out.enabled = !out.weights.empty();
+        return out;
+    }();
