+template<uint64_t D, uint64_t B>
+void IVFRES<D, B>::res_disk_scan(ResultHeap &KNNs, float &distK, uint64_t k,
+                                 uint8_t *LUT, uint8_t *packed_code, uint64_t len, Factor *ptr_fac,
+                                 const float sqr_y, const float res_sqr_y, const float res_error,
+                                 const float p_res_error, const float vl, const float all_sqr_y,
+                                 const float width, const float sumq,
+                                 float *query, float *data, uint64_t *id, Disk_IO *read_buffer) {
+    for (int64_t i = 0; i < B / 4 * 16; i++) LUT[i] *= 2;
+    const float y = std::sqrt(sqr_y);
+    constexpr uint64_t SIZE = 32;
+    uint64_t it = len / SIZE;
+    const uint64_t remain = len - it * SIZE;
+    const uint64_t nblk_remain = (remain + 31) / 32;
+    float residual[D - B + 1];
+
+    auto refine = [&](const float lower_dist, float *prefix, uint64_t vector_id) {
+        if (lower_dist >= distK) return;
+#ifdef COUNT_SCAN
+        count_scan++;
+#endif
+        const float projected_dist = all_sqr_y + prefix[0] -
+                                     2 * mask_last_ip_sim127<B - 1>(query, prefix + 1);
+        if (projected_dist - p_res_error >= distK) return;
+        read_buffer->read_range(vector_id, B - 1, D - B + 1, residual);
+        const float exact_dist = projected_dist -
+                                 2 * ip_sim<D - B + 1>(query + B - 1, residual);
+        if (exact_dist < distK) {
+            KNNs.emplace(exact_dist, vector_id);
+            if (KNNs.size() > k) KNNs.pop();
+            if (KNNs.size() == k) distK = KNNs.top().first;
+        }
+    };
+
+    while (it--) {
+        float low_dist[SIZE];
+        uint16_t PORTABLE_ALIGN32 result[SIZE];
+        accumulate<B>(SIZE / 32, packed_code, LUT, result);
+        packed_code += SIZE * B / 8;
+        for (uint64_t i = 0; i < SIZE; i++) {
+            const float estimate = ptr_fac->sqr_x + sqr_y + res_sqr_y +
+                                   ptr_fac->factor_ppc * vl +
+                                   (result[i] - sumq) * ptr_fac->factor_ip * width;
+            low_dist[i] = estimate - (y * ptr_fac->error + res_error);
+            ptr_fac++;
+#ifdef COUNT_SCAN
+            all_dist_count++;
+#endif
+        }
+        for (uint64_t i = 0; i < SIZE; i++) {
+            refine(low_dist[i], data, *id);
+            data += B;
+            id++;
+        }
+    }
+
+    if (remain > 0) {
+        float low_dist[SIZE];
+        uint16_t PORTABLE_ALIGN32 result[SIZE];
+        accumulate<B>(nblk_remain, packed_code, LUT, result);
+        for (uint64_t i = 0; i < remain; i++) {
+            const float estimate = ptr_fac->sqr_x + sqr_y + res_sqr_y +
+                                   ptr_fac->factor_ppc * vl +
+                                   (result[i] - sumq) * ptr_fac->factor_ip * width;
+            low_dist[i] = estimate - (y * ptr_fac->error + res_error);
+            ptr_fac++;
+#ifdef COUNT_SCAN
+            all_dist_count++;
+#endif
+        }
+        for (uint64_t i = 0; i < remain; i++) {
+            refine(low_dist[i], data, *id);
+            data += B;
+            id++;
+        }
+    }
 }
 
 
