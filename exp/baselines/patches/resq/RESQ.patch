+template<uint64_t D, uint64_t B>
+void IVFRES<D, B>::save_ssd(char *filename) {
+    constexpr uint64_t SSD_MAGIC = 0x3144535351524dULL; // "MRQSSD1"
+    std::ofstream output(filename, std::ios::binary);
+    if (!output) throw std::runtime_error("Cannot create SSD index");
+
+    const uint64_t d = D;
+    const uint64_t b = B;
+#ifdef RESIDUAL_SPLIT
+    const uint64_t layout = 1;
+#else
+    const uint64_t layout = 0;
+#endif
+    output.write(reinterpret_cast<const char *>(&SSD_MAGIC), sizeof(SSD_MAGIC));
+    output.write(reinterpret_cast<const char *>(&N), sizeof(N));
+    output.write(reinterpret_cast<const char *>(&d), sizeof(d));
+    output.write(reinterpret_cast<const char *>(&C), sizeof(C));
+    output.write(reinterpret_cast<const char *>(&b), sizeof(b));
+    output.write(reinterpret_cast<const char *>(&layout), sizeof(layout));
+    output.write(reinterpret_cast<const char *>(start), C * sizeof(uint64_t));
+    output.write(reinterpret_cast<const char *>(len), C * sizeof(uint64_t));
+    output.write(reinterpret_cast<const char *>(id), N * sizeof(uint64_t));
+    output.write(reinterpret_cast<const char *>(dist_to_c), N * sizeof(float));
+    output.write(reinterpret_cast<const char *>(x0), N * sizeof(float));
+    output.write(reinterpret_cast<const char *>(var_), D * sizeof(float));
+    output.write(reinterpret_cast<const char *>(mean_), D * sizeof(float));
+    output.write(reinterpret_cast<const char *>(centroid), C * B * sizeof(float));
+    output.write(reinterpret_cast<const char *>(binary_code),
+                 static_cast<size_t>(N) * B / 64 * sizeof(uint64_t));
+
+    std::vector<float> residual_sqr_norm(N);
+#pragma omp parallel for schedule(static)
+    for (int64_t i = 0; i < static_cast<int64_t>(N); i++) {
+#ifdef RESIDUAL_SPLIT
+        residual_sqr_norm[static_cast<size_t>(i)] =
+                ip_sim<D - B>(res_data + static_cast<size_t>(i) * (D - B + 1) + 1,
+                              res_data + static_cast<size_t>(i) * (D - B + 1) + 1);
+#else
+        residual_sqr_norm[static_cast<size_t>(i)] =
+                ip_sim<D - B>(data + static_cast<size_t>(i) * D + B,
+                              data + static_cast<size_t>(i) * D + B);
+#endif
+    }
+    output.write(reinterpret_cast<const char *>(residual_sqr_norm.data()),
+                 N * sizeof(float));
+#ifdef RESIDUAL_SPLIT
+    // MRQ+ keeps the exact projected prefix in RAM; only the residual tail is on SSD.
+    output.write(reinterpret_cast<const char *>(data),
+                 static_cast<size_t>(N) * B * sizeof(float));
+#endif
+    if (!output) throw std::runtime_error("Failed while writing SSD index");
+    std::cerr << "Saved SSD index: " << filename << std::endl;
+}
+
+template<uint64_t D, uint64_t B>
+void IVFRES<D, B>::load_ssd(char *filename) {
+    constexpr uint64_t SSD_MAGIC = 0x3144535351524dULL; // "MRQSSD1"
+    std::ifstream input(filename, std::ios::binary);
+    if (!input) throw std::runtime_error("Cannot open SSD index");
+
+    uint64_t magic = 0, d = 0, b = 0, layout = 0;
+    input.read(reinterpret_cast<char *>(&magic), sizeof(magic));
+    input.read(reinterpret_cast<char *>(&N), sizeof(N));
+    input.read(reinterpret_cast<char *>(&d), sizeof(d));
+    input.read(reinterpret_cast<char *>(&C), sizeof(C));
+    input.read(reinterpret_cast<char *>(&b), sizeof(b));
+    input.read(reinterpret_cast<char *>(&layout), sizeof(layout));
+    if (magic != SSD_MAGIC || d != D || b != B) {
+        throw std::runtime_error("SSD index header does not match this binary");
+    }
+#ifdef RESIDUAL_SPLIT
+    if (layout != 1) throw std::runtime_error("MRQ+ binary requires split SSD index");
+#else
+    if (layout != 0) throw std::runtime_error("MRQ binary requires non-split SSD index");
+#endif
+    RD = D - B + 1;
+
+    u = new float[B];
+    for (uint64_t i = 0; i < B; i++) u[i] = 0.5f;
+    centroid = new float[static_cast<size_t>(C) * B];
+    start = new uint64_t[C];
+    len = new uint64_t[C];
+    id = new uint64_t[N];
+    dist_to_c = new float[N];
+    x0 = new float[N];
+    fac = new Factor[N];
+    var_ = new float[D];
+    mean_ = new float[D];
+
+    void *binary_memory = nullptr;
+    const size_t binary_bytes = static_cast<size_t>(N) * B / 64 * sizeof(uint64_t);
+    if (::posix_memalign(&binary_memory, 256, binary_bytes) != 0) throw std::bad_alloc();
+    binary_code = static_cast<uint64_t *>(binary_memory);
+
+    input.read(reinterpret_cast<char *>(start), C * sizeof(uint64_t));
+    input.read(reinterpret_cast<char *>(len), C * sizeof(uint64_t));
+    input.read(reinterpret_cast<char *>(id), N * sizeof(uint64_t));
+    input.read(reinterpret_cast<char *>(dist_to_c), N * sizeof(float));
+    input.read(reinterpret_cast<char *>(x0), N * sizeof(float));
+    input.read(reinterpret_cast<char *>(var_), D * sizeof(float));
+    input.read(reinterpret_cast<char *>(mean_), D * sizeof(float));
+    input.read(reinterpret_cast<char *>(centroid), C * B * sizeof(float));
+    input.read(reinterpret_cast<char *>(binary_code), binary_bytes);
+
+    std::vector<float> residual_sqr_norm(N);
+    input.read(reinterpret_cast<char *>(residual_sqr_norm.data()), N * sizeof(float));
+#ifdef RESIDUAL_SPLIT
+    data = new float[static_cast<size_t>(N) * B];
+    input.read(reinterpret_cast<char *>(data), static_cast<size_t>(N) * B * sizeof(float));
+    res_data = nullptr;
+#else
+    data = nullptr;
+    res_data = nullptr;
+#endif
+    if (!input) throw std::runtime_error("Truncated SSD index");
+
+    packed_start = new uint64_t[C];
+    size_t packed_bytes = 0;
+    for (uint64_t i = 0; i < C; i++) {
+        packed_start[i] = packed_bytes;
+        packed_bytes += (len[i] + 31) / 32 * 32 * B / 8;
+    }
+    void *packed_memory = nullptr;
+    if (::posix_memalign(&packed_memory, 32, std::max<size_t>(packed_bytes, 32)) != 0) {
+        throw std::bad_alloc();
+    }
+    packed_code = static_cast<uint8_t *>(packed_memory);
+    for (uint64_t i = 0; i < C; i++) {
+        pack_codes<B>(binary_code + start[i] * (B / 64), len[i],
+                      packed_code + packed_start[i]);
+    }
+
+    double average_error = 0.0;
+#pragma omp parallel for reduction(+: average_error) schedule(static)
+    for (int64_t i = 0; i < static_cast<int64_t>(N); i++) {
+        const long double x_x0 = static_cast<long double>(dist_to_c[i]) / x0[i];
+        fac[i].sqr_x = dist_to_c[i] * dist_to_c[i] +
+                       residual_sqr_norm[static_cast<size_t>(i)];
