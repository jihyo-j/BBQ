+            routing_stats->base_neighbor_scan_count += size;
+        }
+
+        for (size_t j = 1; j <= size; j++) {
+            int candidate_id = *(link_data + j);
+            if (vl->get(candidate_id)) {
+                continue;
+            }
+            vl->set(candidate_id);
+            if (routing_stats != nullptr) {
+                routing_stats->base_visited_count++;
