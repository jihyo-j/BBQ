+        config = quant::faster_config(padded_dim_, ex_bits_ + 1);
+    }
+
+    rawDataPtr_ = raw_data;
+    rabitqlib::ivf::parallel_for(
+        0,
+        add_num,
+        num_threads,
+        [&](size_t idx, size_t /*threadId*/) {
+            add_point(labels[idx], cluster_ids[idx], config);
+        }
+    );
+}
