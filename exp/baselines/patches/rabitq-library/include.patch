@@ -66,6 +66,32 @@ inline void accumulate_hacc(
     int32_t* accu_res,
     size_t dim
 ) {
+    // The SIMD kernel uses 16-bit lanes for each LUT byte.  At most 1024
+    // dimensions (256 codebooks) can be accumulated without overflowing a
+    // lane, so widen and combine larger vectors block by block.
+    if (dim > 1024) {
+        for (size_t i = 0; i < 32; ++i) {
+            accu_res[i] = 0;
+        }
+        size_t consumed_dim = 0;
+        while (consumed_dim < dim) {
+            const size_t remaining = dim - consumed_dim;
+            const size_t block_dim = remaining > 1024 ? 1024 : remaining;
+            alignas(64) int32_t block_res[32];
+            accumulate_hacc(
+                codes + consumed_dim * 4,
+                hc_lut + consumed_dim * 8,
+                block_res,
+                block_dim
+            );
+            for (size_t i = 0; i < 32; ++i) {
+                accu_res[i] += block_res[i];
+            }
+            consumed_dim += block_dim;
+        }
+        return;
+    }
+
