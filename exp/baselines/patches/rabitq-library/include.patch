+inline std::vector<float> HierarchicalNSW::estimate_dist_for_labels(
+    const float* queries,
+    const PID* labels,
+    size_t num_queries,
+    size_t labels_per_query,
+    size_t thread_num
+) {
+    std::vector<float> result(
+        num_queries * labels_per_query,
+        std::numeric_limits<float>::infinity()
+    );
+
+    rabitqlib::ivf::parallel_for(
+        0,
+        num_queries,
+        thread_num,
+        [&](size_t qi, size_t /*thread_id*/) {
+            std::vector<float> rotated_query(padded_dim_);
+            this->rotator_->rotate(
+                queries + (qi * dim_),
+                rotated_query.data()
+            );
+
+            SplitSingleQuery<float> query_wrapper(
+                rotated_query.data(),
+                padded_dim_,
+                ex_bits_,
+                query_config_,
+                metric_type_
+            );
+
+            std::vector<float> q_to_centroids(num_cluster_);
+
+            if (metric_type_ == METRIC_L2) {
+                for (size_t c = 0; c < num_cluster_; ++c) {
+                    q_to_centroids[c] = std::sqrt(raw_dist_func_(
+                        rotated_query.data(),
+                        reinterpret_cast<float*>(centroids_memory_) + (c * padded_dim_),
+                        padded_dim_
+                    ));
+                }
+            } else if (metric_type_ == METRIC_IP) {
+                q_to_centroids.resize(2 * num_cluster_);
+
+                for (size_t c = 0; c < num_cluster_; ++c) {
+                    q_to_centroids[c] = dot_product(
+                        rotated_query.data(),
+                        reinterpret_cast<float*>(centroids_memory_) + (c * padded_dim_),
+                        padded_dim_
+                    );
+
+                    q_to_centroids[c + num_cluster_] =
+                        std::sqrt(euclidean_sqr(
+                            rotated_query.data(),
+                            reinterpret_cast<float*>(centroids_memory_) + (c * padded_dim_),
+                            padded_dim_
+                        ));
+                }
+            }
+
+            for (size_t j = 0; j < labels_per_query; ++j) {
+                const PID label = labels[qi * labels_per_query + j];
+                const PID internal_id = internal_id_for_label(label);
+                if (internal_id == kPidMax) {
+                    continue;
+                }
+
+                EstimateRecord rec;
+                if (ex_bits_ > 0) {
+                    get_full_est(q_to_centroids, query_wrapper, internal_id, rec);
+                } else {
+                    get_bin_est(q_to_centroids, query_wrapper, internal_id, rec);
+                }
+
+                result[qi * labels_per_query + j] = rec.est_dist;
+            }
+        }
+    );
+
+    return result;
+}
