+    if (routing_stats != nullptr) {
+        routing_stats->base_visited_count++;
+        if (routing_trace_max > 0) {
+            routing_stats->base_visited_labels.push_back(get_external_label(curr_obj));
+        }
+    }
+
+    float distk = boundedKnn.worst().record.est_dist;
+    while (candidate_set.has_next()) {
+        const float current_candidate_dist = candidate_set.next_dist();
+        const PID current_node_id_before_pop = candidate_set.next_id();
+        if (routing_stats != nullptr) {
+            routing_stats->base_pop_count++;
