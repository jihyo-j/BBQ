+inline std::vector<std::vector<std::pair<float, PID>>> HierarchicalNSW::search_1bit_fp_rerank(
+    const float* queries,
+    const float* raw_data,
+    size_t raw_data_rows,
+    size_t query_num,
+    size_t TOPK,
+    size_t efSearch,
+    size_t thread_num
+) {
+    set_ef(efSearch);
+    std::vector<std::vector<std::pair<float, PID>>> results(query_num);
+    rabitqlib::ivf::parallel_for(
+        0,
+        query_num,
+        thread_num,
+        [&](size_t idx, size_t /*threadId*/) {
+            const float* raw_query = queries + (idx * dim_);
+            std::vector<float> rotated_query(padded_dim_);
+            this->rotator_->rotate(raw_query, rotated_query.data());
+            maxheap<std::pair<float, PID>> knn = search_knn(
+                rotated_query.data(),
+                TOPK,
+                nullptr,
+                0,
+                raw_query,
+                raw_data,
+                raw_data_rows
+            );
+            while (knn.size()) {
+                results[idx].emplace_back(knn.top());
+                knn.pop();
+            }
+            std::reverse(results[idx].begin(), results[idx].end());
+        }
+    );
+    return results;
+}
