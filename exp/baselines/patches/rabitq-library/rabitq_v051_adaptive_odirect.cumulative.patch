+struct FbinODirectReader {
+    int fd = -1;
+    int32_t n = 0;
+    int32_t d = 0;
+    size_t row_bytes = 0;
+    uint64_t data_offset = 0;
+    mutable std::atomic<uint64_t> read_bytes{0};
+    mutable std::atomic<uint64_t> read_requests{0};
+    mutable std::atomic<uint64_t> read_ns{0};
