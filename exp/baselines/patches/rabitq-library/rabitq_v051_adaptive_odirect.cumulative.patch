+inline maxheap<std::pair<float, PID>>
+HierarchicalNSW::search_knn_1bit_adaptive_fp(
+    const float* rotated_query,
+    size_t TOPK,
+    const std::function<float(PID)>& exact_distance,
+    size_t& fp_reads
+) {
+    maxheap<std::pair<float, PID>> result;
+    if (cur_element_count_ == 0) {
+        return result;
+    }
+
+    SplitSingleQuery<float> query_wrapper(
+        rotated_query, padded_dim_, ex_bits_, query_config_, metric_type_
+    );
+
+    std::vector<float> q_to_centroids(num_cluster_);
+    if (metric_type_ == METRIC_L2) {
+        for (size_t i = 0; i < num_cluster_; ++i) {
+            q_to_centroids[i] = std::sqrt(raw_dist_func_(
+                rotated_query,
+                reinterpret_cast<float*>(centroids_memory_) + (i * padded_dim_),
+                padded_dim_
+            ));
+        }
+    } else {
+        q_to_centroids.resize(2 * num_cluster_);
+        for (size_t i = 0; i < num_cluster_; ++i) {
+            q_to_centroids[i] = dot_product(
+                rotated_query,
+                reinterpret_cast<float*>(centroids_memory_) + (i * padded_dim_),
+                padded_dim_
+            );
+            q_to_centroids[i + num_cluster_] = std::sqrt(euclidean_sqr(
+                rotated_query,
+                reinterpret_cast<float*>(centroids_memory_) + (i * padded_dim_),
+                padded_dim_
+            ));
+        }
+    }
+
+    PID curr_obj = enterpoint_node_;
+    EstimateRecord current_estimate;
+    get_bin_est_runtime(q_to_centroids, query_wrapper, curr_obj, current_estimate);
+
+    for (int level = maxlevel_; level > 0; --level) {
+        bool changed = true;
+        while (changed) {
+            changed = false;
+            unsigned int* data =
+                static_cast<unsigned int*>(get_linklist(curr_obj, level));
+            const int size = get_list_count(data);
+            PID* labels = static_cast<PID*>(data + 1);
+            for (int i = 0; i < size; ++i) {
+                const PID candidate = labels[i];
+                if (candidate >= cur_element_count_) {
+                    throw std::runtime_error("corrupt HNSW upper-layer candidate");
+                }
+                EstimateRecord candidate_estimate;
+                get_bin_est_runtime(
+                    q_to_centroids, query_wrapper, candidate, candidate_estimate
+                );
+                if (candidate_estimate.est_dist < current_estimate.est_dist) {
+                    current_estimate = candidate_estimate;
+                    curr_obj = candidate;
+                    changed = true;
+                }
+            }
+        }
+    }
+
+    BoundedKNN bounded_knn(TOPK);
+    search_base_layer_1bit_adaptive_fp(
+        curr_obj,
+        std::max(ef_, TOPK),
+        TOPK,
+        query_wrapper,
+        q_to_centroids,
+        exact_distance,
+        bounded_knn,
+        fp_reads
+    );
+    for (const auto& candidate : bounded_knn.candidates()) {
+        result.emplace(candidate.record.est_dist, get_external_label(candidate.id));
+    }
+    return result;
+}
+
+inline void HierarchicalNSW::search_base_layer_1bit_adaptive_fp(
+    PID ep_id,
+    size_t ef,
+    size_t TOPK,
+    SplitSingleQuery<float>& query_wrapper,
+    std::vector<float>& q_to_centroids,
+    const std::function<float(PID)>& exact_distance_external,
+    BoundedKNN& bounded_knn,
+    size_t& fp_reads
+) {
+    VisitedSet* visited = visited_list_pool_->get_free_vislist();
+    buffer::SearchBuffer<float> candidate_set(ef);
+
+    auto exact_distance = [&](PID internal_id) -> float {
+        const PID label = get_external_label(internal_id);
+        ++fp_reads;
+        return exact_distance_external(label);
+    };
+
+    EstimateRecord entry_estimate;
+    get_bin_est_runtime(q_to_centroids, query_wrapper, ep_id, entry_estimate);
+    const float entry_queue_distance = entry_estimate.est_dist;
+    const float entry_exact_distance = exact_distance(ep_id);
+    bounded_knn.insert(
+        {ResultRecord(entry_exact_distance, entry_exact_distance), ep_id}
+    );
+    candidate_set.insert(ep_id, entry_queue_distance);
+    float dist_k = entry_exact_distance;
+    visited->set(ep_id);
+
+    const size_t prefetch_size = (((padded_dim_ / 8) + 63) / 64) + 1;
+    constexpr size_t kPrefetchLookahead = 4;
+
+    while (candidate_set.has_next()) {
+        const PID current_node = candidate_set.pop();
+        int* links = reinterpret_cast<int*>(get_linklist0(current_node));
+        const size_t size = get_list_count(reinterpret_cast<PID*>(links));
+
+        for (size_t p = 0; p < std::min(kPrefetchLookahead, size); ++p) {
+            rabitqlib::memory::mem_prefetch_l1(
+                get_bindata_by_internalid(*(links + 1 + p)), prefetch_size
+            );
+        }
+
+        for (size_t j = 1; j <= size; ++j) {
+            const PID candidate_id = static_cast<PID>(*(links + j));
+            if (j + kPrefetchLookahead <= size) {
+                rabitqlib::memory::mem_prefetch_l1(
+                    get_bindata_by_internalid(*(links + j + kPrefetchLookahead)),
+                    prefetch_size
+                );
+            }
+            if (visited->get(candidate_id)) {
+                continue;
+            }
+            visited->set(candidate_id);
+
+            EstimateRecord estimate;
+            get_bin_est_runtime(q_to_centroids, query_wrapper, candidate_id, estimate);
+            const float queue_distance = estimate.est_dist;
+            const bool promising =
+                bounded_knn.size() < TOPK || estimate.low_dist < dist_k;
+            if (promising) {
+                const float fp_distance = exact_distance(candidate_id);
+                bounded_knn.insert(
+                    {ResultRecord(fp_distance, fp_distance), candidate_id}
+                );
+                dist_k = bounded_knn.worst().record.est_dist;
+            }
+
+            if (!candidate_set.is_full(queue_distance)) {
+                candidate_set.insert(candidate_id, queue_distance);
+            }
+            if (candidate_set.has_next()) {
+                rabitqlib::memory::mem_prefetch_l2(
+                    reinterpret_cast<char*>(get_linklist0(candidate_set.next_id())), 2
+                );
+            }
+        }
+    }
+
+    visited_list_pool_->release_vis_list(visited);
+}
