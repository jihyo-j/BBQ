+    explicit FbinODirectReader(const std::string& path) {
+        const int header_fd = ::open(path.c_str(), O_RDONLY);
+        if (header_fd < 0) {
+            throw std::runtime_error("open failed: " + path + ": " + std::strerror(errno));
+        }
+        int32_t header[2];
+        if (::pread(header_fd, header, sizeof(header), 0) !=
+            static_cast<ssize_t>(sizeof(header))) {
+            ::close(header_fd);
+            throw std::runtime_error("bad fbin header: " + path);
+        }
+        n = header[0];
+        d = header[1];
+        if (n <= 0 || d <= 0) {
+            ::close(header_fd);
+            throw std::runtime_error("invalid fbin shape: " + path);
+        }
+        row_bytes = static_cast<size_t>(d) * sizeof(float);
+        struct stat st {};
+        if (::fstat(header_fd, &st) != 0 || st.st_size < 0) {
