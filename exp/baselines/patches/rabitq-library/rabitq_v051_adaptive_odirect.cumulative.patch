+            static_cast<uint64_t>(n) * static_cast<uint64_t>(row_bytes);
+        const uint64_t file_bytes = static_cast<uint64_t>(st.st_size);
+        if (file_bytes == 4096ULL + payload_bytes) {
+            data_offset = 4096ULL;
+        } else if (file_bytes == 8ULL + payload_bytes) {
+            data_offset = 8ULL;
