+inline AdaptiveFpSearchResult HierarchicalNSW::search_1bit_adaptive_fp(
+    const float* queries,
+    const float* raw_data,
+    size_t raw_data_rows,
+    size_t query_num,
+    size_t TOPK,
+    size_t efSearch,
+    size_t thread_num
+) {
+    if (ex_bits_ != 0) {
+        throw std::invalid_argument(
+            "search_1bit_adaptive_fp requires a 1-bit RaBitQ index"
+        );
+    }
+    if (queries == nullptr || raw_data == nullptr) {
+        throw std::invalid_argument("adaptive FP search received null input");
+    }
+    if (TOPK == 0 || TOPK > cur_element_count_) {
+        throw std::invalid_argument("invalid top-k for adaptive FP search");
+    }
+
+    set_ef(efSearch);
+    AdaptiveFpSearchResult output;
+    output.results.resize(query_num);
+    output.fp_read_count.resize(query_num, 0);
+    output.query_latency_ns.resize(query_num, 0);
+    rabitqlib::ivf::parallel_for(
+        0,
+        query_num,
+        thread_num,
+        [&](size_t idx, size_t /*thread_id*/) {
+            const auto query_start = std::chrono::steady_clock::now();
+            const float* raw_query = queries + (idx * dim_);
+            std::vector<float> rotated_query(padded_dim_);
+            rotator_->rotate(raw_query, rotated_query.data());
+            size_t fp_reads = 0;
+            const std::function<float(PID)> exact_distance = [&](PID label) {
+                if (label >= raw_data_rows) {
+                    throw std::runtime_error("RaBitQ label exceeds FP rerank rows");
+                }
+                return raw_dist_func_(
+                    raw_query,
+                    raw_data + (static_cast<size_t>(label) * dim_),
+                    dim_
+                );
+            };
+            maxheap<std::pair<float, PID>> knn = search_knn_1bit_adaptive_fp(
+                rotated_query.data(),
+                TOPK,
+                exact_distance,
+                fp_reads
+            );
+            while (!knn.empty()) {
+                output.results[idx].emplace_back(knn.top());
+                knn.pop();
+            }
+            std::reverse(output.results[idx].begin(), output.results[idx].end());
+            output.fp_read_count[idx] = fp_reads;
+            output.query_latency_ns[idx] = static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    std::chrono::steady_clock::now() - query_start
+                ).count()
+            );
+        }
+    );
+    return output;
+}
