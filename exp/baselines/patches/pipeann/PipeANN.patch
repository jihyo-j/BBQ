+  inline void print_query_stats_block(QueryStats *stats, uint64_t len, uint64_t block) {
+    const auto old_flags = std::cout.flags();
+    const auto old_precision = std::cout.precision();
+    const auto emit = [&](const char *name, const std::function<double(const QueryStats &)> &fn) {
+      std::vector<double> values(len);
+      double sum = 0.0;
+      for (uint64_t i = 0; i < len; ++i) {
+        values[i] = fn(stats[i]);
+        sum += values[i];
+      }
+      std::sort(values.begin(), values.end());
+      const auto pick = [&](double q) {
+        return values[static_cast<uint64_t>(q * static_cast<double>(len - 1))];
+      };
+      std::cout << std::setprecision(12)
+                << "PIPEANN_QUERY_STATS block=" << block << " metric=" << name
+                << " mean=" << sum / static_cast<double>(len)
+                << " min=" << values.front() << " max=" << values.back()
+                << " p95=" << pick(0.95) << " p99=" << pick(0.99) << '\n';
+    };
+    emit("latency_us", [](const QueryStats &s) { return s.total_us; });
+    emit("page_reads_4k", [](const QueryStats &s) { return s.n_ios; });
+    emit("io_requests", [](const QueryStats &s) { return s.n_io_requests; });
+    emit("read_bytes", [](const QueryStats &s) { return s.n_ios * 4096.0; });
+    emit("io_us", [](const QueryStats &s) { return s.io_us; });
+    emit("cpu_us", [](const QueryStats &s) { return s.cpu_us; });
+    emit("head_us", [](const QueryStats &s) { return s.head_us; });
+    emit("comparisons", [](const QueryStats &s) { return s.n_cmps; });
+    emit("hops", [](const QueryStats &s) { return s.n_hops; });
+    std::cout.flags(old_flags);
+    std::cout.precision(old_precision);
+    std::cout.flush();
+  }
