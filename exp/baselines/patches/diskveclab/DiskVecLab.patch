+void print_query_distribution(uint32_t search_l, const std::string &metric, diskann::QueryStats *stats,
+                              size_t query_num,
+                              const std::function<double(const diskann::QueryStats &)> &value_fn)
+{
+    std::vector<double> values(query_num);
+    double sum = 0.0;
+    for (size_t i = 0; i < query_num; ++i)
+    {
+        values[i] = value_fn(stats[i]);
+        sum += values[i];
+    }
+    std::sort(values.begin(), values.end());
+    const auto percentile = [&values](double fraction) {
+        if (values.size() == 1)
+            return values[0];
+        const double position = fraction * static_cast<double>(values.size() - 1);
+        const size_t lower = static_cast<size_t>(position);
+        const size_t upper = std::min(lower + 1, values.size() - 1);
+        const double weight = position - static_cast<double>(lower);
+        return values[lower] + weight * (values[upper] - values[lower]);
+    };
+    const auto old_precision = diskann::cout.precision();
+    diskann::cout.precision(6);
+    diskann::cout << "QUERY_STATS L=" << search_l << " metric=" << metric
+                  << " mean=" << (sum / static_cast<double>(query_num)) << " min=" << values.front()
+                  << " max=" << values.back() << " p95=" << percentile(0.95) << " p99=" << percentile(0.99)
+                  << std::endl;
+    diskann::cout.precision(old_precision);
+}
