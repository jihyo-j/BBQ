@@ -1343,3 +1343,17 @@ inline void helper_float_11(float *buf);
 inline void helper_float_11(float *buf) {
   helper_float_11_recursive(buf, 11);
 }
+inline void helper_float_12(float *buf) {
+  // H_4096 = [[H_2048, H_2048], [H_2048, -H_2048]].
+  // Reuse the generated 2048-point kernel and finish with one AVX2
+  // butterfly stage.  This keeps exactly the same unnormalised FHT
+  // convention as helper_float_6..11; the rotator applies 1/sqrt(d).
+  helper_float_11(buf);
+  helper_float_11(buf + 2048);
+  for (int i = 0; i < 2048; i += 8) {
+    const __m256 x = _mm256_loadu_ps(buf + i);
+    const __m256 y = _mm256_loadu_ps(buf + 2048 + i);
+    _mm256_storeu_ps(buf + i, _mm256_add_ps(x, y));
+    _mm256_storeu_ps(buf + 2048 + i, _mm256_sub_ps(x, y));
+  }
+}
