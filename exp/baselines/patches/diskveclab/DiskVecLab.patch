+
+void ValidateUInt8VectorFile(const std::string& path, SizeType expectedRows, DimensionType expectedDim)
+{
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (!input)
+    {
+        throw std::runtime_error("Failed to validate quantized vector file: " + path);
+    }
+    const std::streamoff actualBytes = input.tellg();
+    input.seekg(0, std::ios::beg);
+    SizeType rows = -1;
+    DimensionType dim = -1;
+    input.read(reinterpret_cast<char*>(&rows), sizeof(rows));
+    input.read(reinterpret_cast<char*>(&dim), sizeof(dim));
+    const std::uint64_t expectedBytes = sizeof(SizeType) + sizeof(DimensionType) +
+        static_cast<std::uint64_t>(expectedRows) * static_cast<std::uint64_t>(expectedDim);
+    if (!input || rows != expectedRows || dim != expectedDim ||
+        actualBytes < 0 || static_cast<std::uint64_t>(actualBytes) != expectedBytes)
+    {
+        throw std::runtime_error("Quantized vector header or payload size mismatch: " + path);
+    }
+}
