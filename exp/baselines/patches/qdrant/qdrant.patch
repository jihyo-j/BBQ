+    /// Export the signed 16-bit query values represented by the two byte
+    /// planes. This is intended for embedding the TurboQuant scorer in a
+    /// foreign traversal implementation without crossing an FFI boundary for
+    /// every distance evaluation.
+    pub fn export_signed_i16(&self, output: &mut [i16]) -> bool {
+        if QUERY_BYTES != 2 || output.len() != self.vector_bytes * PLANES {
+            return false;
+        }
+        for (i, value) in output.iter_mut().enumerate() {
+            let (j, k) = (i / PLANES, i % PLANES);
+            let low = i16::from(self.planes.plane(0, k)[j]);
+            let high = i16::from(self.planes.plane(1, k)[j]);
+            *value = low + 256 * high;
+        }
+        true
+    }
+
+    /// Float multiplier applied after the integer dot product.
+    pub fn postprocess_scale(&self) -> f32 {
+        self.postprocess_scale
+    }
+
+    /// Unsigned-codebook bias subtracted before float reconstruction.
+    pub fn bias_correction(&self) -> i64 {
+        self.bias_correction
+    }
+
+    /// Export the SIMD query planes in their native contiguous layout.
+    pub fn export_planes_i8(&self, output: &mut [i8]) -> bool {
+        if output.len() != self.planes.data.len() {
+            return false;
+        }
+        output.copy_from_slice(&self.planes.data);
+        true
+    }
