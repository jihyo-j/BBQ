+/// Scalar parameters accompanying an exported TQ+ Bits1 wide query.
+pub struct Bits1WideQueryExport {
+    pub postprocess_scale: f32,
+    pub bias_correction: i64,
+    pub ec_correction: f32,
+    pub l2_norm: Option<f32>,
+}
+
+impl EncodedQueryTQ {
+    /// Export the integer query consumed by the 1-bit asymmetric scorer.
+    /// Database scoring can then run in the caller while query rotation and
+    /// quantization remain in the canonical TurboQuant implementation.
+    pub fn export_bits1_wide(&self, output: &mut [i16]) -> Option<Bits1WideQueryExport> {
+        let EncodedQueryTQData::Bits1Wide(query) = &self.data else {
+            return None;
+        };
+        if !query.export_signed_i16(output) {
+            return None;
+        }
+        Some(Bits1WideQueryExport {
+            postprocess_scale: query.postprocess_scale(),
+            bias_correction: query.bias_correction(),
+            ec_correction: self.ec_correction,
+            l2_norm: self.l2_norm,
+        })
+    }
+
+    /// Export the native two-byte, eight-plane layout used by the AVX-512
+    /// Bits1Wide scorer.
+    pub fn export_bits1_wide_planes(
+        &self,
+        output: &mut [i8],
+    ) -> Option<Bits1WideQueryExport> {
+        let EncodedQueryTQData::Bits1Wide(query) = &self.data else {
+            return None;
+        };
+        if !query.export_planes_i8(output) {
+            return None;
+        }
+        Some(Bits1WideQueryExport {
+            postprocess_scale: query.postprocess_scale(),
+            bias_correction: query.bias_correction(),
+            ec_correction: self.ec_correction,
+            l2_norm: self.l2_norm,
+        })
+    }
+}
