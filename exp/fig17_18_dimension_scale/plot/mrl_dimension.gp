# mrl_dimension — generated by make_scal_dim.py
load "../../common/plot/common.gp"
LEGROWS = 0
FONT = "Carlito"; FT = 6.5; FL = 7.0
PW = 113.075; PH = 77.0; PBOT = 17.5; LEGB = LEGROWS*8.5 + (LEGROWS ? 1.0 : 0.0)
W = 506.3; H = PBOT + PH + 1.0 + TTL + LEGB; OUT = "mrl_dimension"
eval SETTERM
set style line 1 lc rgb C_PINK   lw LW pt 4  ps PS             # BBQ
set style line 2 lc rgb C_PURPLE lw LW pt 12 ps PS*1.25        # TurboQuant 1bit
set style line 3 lc rgb C_BLUE   lw LW pt 6  ps PS             # RaBitQ 1bit + adaptive rerank
set style line 4 lc rgb C_BLUE   lw LW pt 8  ps PS*1.1 dt (6,3) # RaBitQ 7bit (RAM)
set multiplot
SMP = 12.0; GST = 2.5
eval DRAWSCREEN
set tics in nomirror scale TICMAJ,0 font ",".sprintf("%g",FT)
unset mxtics; unset mytics
set logscale y
set yrange [45.5:23456.1]
set nonlinear x via -log10(1-x) inverse 1-10**(-x)
D = "mrl_dimension.dat"
# 512
set origin (24.0 + 0*(PW + 8.0))/W, PBOT/H; set size PW/W, PH/H
set lmargin 0; set rmargin 0; set tmargin 0; set bmargin 0
