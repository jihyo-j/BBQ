# Intro motivation figure: which embeddings are actually served, and which
# representations ANN evaluations actually run on.  Terminal and fonts follow
# recall_qps.gp; axis furniture is lighter than that template because the two
# panels are stacked in one column.  Provenance, aggregation method and the
# meaning of the bold model names belong in the LaTeX caption, not here.
set terminal pdfcairo enhanced font "Liberation Sans,8" fontscale 0.75 \
    linewidth 1 size 3.33in,3.05in
set output "embuse.pdf"

NAVY = "#355C7D"    # (a) every bar
MOD  = "#278A83"    # (b) Transformer / modern API
CONV = "#BEC5CC"    # (b) conventional / raw
OTHR = "#8D99A5"    # (b) other learned / neural
HATCH= "#C4CBD2"    # (b) unresolved provenance: white with a pale hatch
INK  = "#262626"

set border 3 lw 1.0
set tics in nomirror scale 0.8,0.4 font ",7" tc rgb INK
unset x2tics; unset y2tics; unset grid
set bmargin 0; set tmargin 0; set lmargin 0; set rmargin 0

set multiplot

# =====================================================================
# (a)  API usage -- horizontal bars, requests descending, one colour
# =====================================================================
set lmargin at screen 0.265
set rmargin at screen 0.975
set bmargin at screen 0.735
set tmargin at screen 0.950
set title "(a) API usage" font ",8" offset 0,-0.8 tc rgb INK
set xlabel "API requests (millions)" font ",7.5" offset 0,1.0 tc rgb INK
unset ylabel
set xrange [0:170]
set xtics 0,50,150 font ",7" offset 0,0.35
unset mxtics
set ytics ("{/:Bold OpenAI 3-small}" 0, "{/:Bold Qwen3-8B}" 1, \
           "Gemini Emb-2" 2, "Gemini Emb-001" 3, \
           "{/:Bold OpenAI 3-large}" 4, "{/:Bold BGE-M3}" 5) \
          font ",7" offset 0.5,0 scale 0
set yrange [5.7:-0.7]
unset key
set style fill solid 1.0 noborder
plot "api_usage.dat" u 2:1:(0):2:($1-0.32):($1+0.32) \
         w boxxyerror lc rgb NAVY notitle, \
     "api_usage.dat" u ($2+4.5):1:(sprintf("%gM", $2)) \
         w labels left font ",6.5" tc rgb INK notitle

# =====================================================================
# (b)  VLDB evaluation mix -- 100 per cent stacked bars by year
# =====================================================================
set lmargin at screen 0.175
set rmargin at screen 0.975
set bmargin at screen 0.250
set tmargin at screen 0.530
set title "(b) VLDB evaluation mix" font ",8" offset 0,-0.3 tc rgb INK
set xlabel ""
set ylabel "Evaluation groups (%)" font ",7.5" offset 2.6,0 tc rgb INK
set xrange [2020.45:2026.55]
set xtics ("2021" 2021, "2022" 2022, "2023" 2023, "2024" 2024, \
           "2025" 2025, "2026" 2026) font ",6.5" offset 0,0.35 scale 0
unset mxtics
set yrange [0:100]
set ytics 0,25,100 font ",7"
unset mytics
unset key
set boxwidth 0.64
# drawn top down, each slab painting over the one beneath it.  vldb_pct.dat is
# generated by make_vldb_pct.py and its slabs now run in legend order
# (modern, other learned, conventional, unresolved); columns 3 and 4 swapped
# meaning when that order was fixed.
set style fill pattern 5 border lc rgb "#CCD2D8"
plot "vldb_pct.dat" u 1:5 w boxes lc rgb HATCH notitle
set style fill solid 1.0 noborder
plot "vldb_pct.dat" u 1:4 w boxes lc rgb CONV notitle, \
     "vldb_pct.dat" u 1:3 w boxes lc rgb OTHR notitle, \
     "vldb_pct.dat" u 1:2 w boxes lc rgb MOD  notitle, \
     "vldb_pct.dat" u 1:($2 > 12 ? $2/2 : $2 + 6.5):7 \
         w labels center font ",6.5" tc rgb INK notitle

# =====================================================================
# legend for (b) only, two rows beneath it
# =====================================================================
unset border; unset tics; unset xlabel; unset ylabel; unset title
set lmargin at screen 0; set rmargin at screen 1
set bmargin at screen 0; set tmargin at screen 1
set xrange [0:1]; set yrange [0:1]
set style fill solid 1.0 noborder
set key horizontal maxcols 2 center at screen 0.545,0.108 samplen 1.1 \
    spacing 1.05 width -1 font ",6.5" tc rgb INK
plot NaN w boxes fs solid 1.0 noborder lc rgb MOD  t "Transformer / modern API", \
     NaN w boxes fs solid 1.0 noborder lc rgb OTHR t "Other learned / neural", \
     NaN w boxes fs solid 1.0 noborder lc rgb CONV t "Conventional / raw", \
     NaN w boxes fs pattern 5 border lc rgb "#CCD2D8" lc rgb HATCH \
         t "Unresolved provenance"

unset multiplot
unset output
